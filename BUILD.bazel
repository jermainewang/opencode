load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

# Sandbox OCI image
#
# Bundles the OpenCode binary, web UI assets (from the opencode submodule),
# and drama-script-agent configuration into a single image used as the base
# for all Daytona sandbox snapshots.
#
# Build:  bazel build //projects/codes/opencode:opencode_image
# Push:   bazel run  //projects/codes/opencode:opencode_image_push
#         (or use ./scripts/push_opencode_image.sh for the Docker-based path)
#
# Prerequisites for local build:
#   cd projects/codes/opencode && bun install

# ── opencode binary ───────────────────────────────────────────────────────────
# genrule fallback: shells out to bun to build the binary.
# Requires `bun install` to have been run in projects/codes/opencode first.
# Replace with rules_js bun rules once stable bun toolchain support is confirmed.
genrule(
    name = "opencode_bin",
    srcs = glob(
        [
            "packages/opencode/**",
            "bun.lock",
            "package.json",
            "bunfig.toml",
        ],
        exclude = [
            "packages/opencode/dist/**",
        ],
    ),
    outs = ["opencode"],
    cmd = """
        set -euo pipefail
        export PATH="/snap/bin:/usr/local/bin:$$PATH"
        # Capture absolute output path before changing directories
        OUTFILE=$$(realpath $(OUTS))
        SRCDIR=$$(realpath $$(dirname $(execpath package.json)))
        cd "$$SRCDIR"
        bun run --cwd packages/opencode build --single 2>&1
        BINARY=$$(ls packages/opencode/dist/opencode-*/bin/opencode 2>/dev/null | head -1)
        if [ -z "$$BINARY" ]; then
            echo "ERROR: opencode binary not found after build — run 'bun install' first" >&2
            exit 1
        fi
        install -m 0755 "$$BINARY" "$$OUTFILE"
    """,
    local = True,
)

# ── web UI assets ─────────────────────────────────────────────────────────────
genrule(
    name = "opencode_ui_tar",
    srcs = glob(
        [
            "packages/app/**",
            "bun.lock",
            "package.json",
            "bunfig.toml",
        ],
        exclude = [
            "packages/app/dist/**",
        ],
    ),
    outs = ["opencode_ui.tar"],
    cmd = """
        set -euo pipefail
        export PATH="/snap/bin:/usr/local/bin:$$PATH"
        OUTFILE=$$(realpath $(OUTS))
        SRCDIR=$$(realpath $$(dirname $(execpath package.json)))
        cd "$$SRCDIR"
        bun run --cwd packages/app build 2>&1
        tar -cf "$$OUTFILE" -C packages/app/dist .
    """,
    local = True,
)

# ── layer tarballs ─────────────────────────────────────────────────────────────
pkg_tar(
    name = "opencode_layer",
    srcs = [":opencode_bin"],
    package_dir = "/usr/local/bin",
)

pkg_tar(
    name = "opencode_ui_layer",
    srcs = [":opencode_ui_tar"],
    package_dir = "/opt/opencode-ui",
)

# ── sandbox OCI image ──────────────────────────────────────────────────────────
oci_image(
    name = "opencode_image",
    base = "@ubuntu_22_04",
    tars = [
        ":opencode_layer",
        ":opencode_ui_layer",
        "//projects/codes/drama-script-agent:agent_config_layer",
    ],
    visibility = ["//visibility:public"],
)

# ── push to container registry ─────────────────────────────────────────────────
# Usage: bazel run //projects/codes/opencode:opencode_image_push
oci_push(
    name = "opencode_image_push",
    image = ":opencode_image",
    repository = "ghcr.io/creativefitting-agentcore-team/opencode",
)
